# Dependencies
node_modules/

# Build output (`next build` writes .next/; out/ is the static-export dir)
.next/
out/

# Generated by `next dev` / `next build`; it references .next/types, so it is build-dependent
next-env.d.ts
*.tsbuildinfo

# Environment files and secrets: never commit values (the template .env.example stays tracked)
.env
.env.*
!.env.example
secrets/
*.key
*.pem
.npmrc

# Databases and SQLite sidecar files (the live graph is ~/.openclaw/data/people.sqlite, outside this repo)
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db
*.db-wal
*.db-shm
*.db-journal

# Person photos and uploads (the archive is ~/.openclaw/data/people-media/, outside this repo)
/people-media/
/photos/
/media/
/uploads/

# Google Takeout exports for scripts/import_google_maps.py: labelled places = real people's addresses
/takeout/
/Takeout/
Labeled places*.json
scripts/*.csv

# Logs
*.log
logs/
npm-debug.log*

# Python tooling (scripts/import_google_maps.py): venvs and bytecode caches
.venv/
__pycache__/
*.pyc

# Backups and editor leftovers
*.bak*
*.orig
*~
*.swp

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local Claude Code settings (this repo has no shared project skills in .claude/; CLAUDE.md stays tracked)
.claude/
CLAUDE.local.md
